# Copy to .env.local and fill in. On Vercel, set these in Project → Settings → Environment Variables.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# Database name for leads + subscribers. Defaults to "ellor" if unset.
# MONGODB_DB=ellor

# Optional. Client fetches the API at this base. Defaults to the same-origin "/api".
# Leave unset for the normal single-project Vercel deploy.
# NEXT_PUBLIC_API_URL=/api

# --- Lead notification email ---------------------------------------------
# Every contact-form / strategy-call submission is emailed here. Defaults to
# officialellordigital@gmail.com when unset.
# LEAD_NOTIFY_TO=officialellordigital@gmail.com

# SMTP credentials used to send that email. For Gmail: turn on 2-Step
# Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16-character code
# as SMTP_PASS (your normal Gmail password will NOT work).
SMTP_USER=officialellordigital@gmail.com
SMTP_PASS=

# Optional — only needed for a non-Gmail provider.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
